{
  "name": "@impact-llm/cli",
  "version": "0.1.0",
  "description": "Launch coding clients through Impact LLM.",
  "bin": {
    "impact": "./dist/impact.js"
  },
  "files": [
    "dist/impact.js",
    "README.md"
  ],
  "type": "module",
  "scripts": {
    "dev": "IMPACT_LAUNCH_CWD=\"${IMPACT_LAUNCH_CWD:-$PWD}\" IMPACT_BASE_URL=\"${IMPACT_BASE_URL:-http://impactllm.localhost:4420}\" bun --no-env-file src/main.ts",
    "build": "bun --no-env-file build.ts",
    "build:bin": "bun --no-env-file build.ts --compile",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-rc.118",
    "@impact-llm/schemas": "workspace:*",
    "better-auth": "1.7.6",
    "effect": "4.0.0-rc.118",
    "env-paths": "4.0.0",
    "es-toolkit": "1.52.0",
    "http-proxy": "1.18.1",
    "open": "11.0.4",
    "selfsigned": "5.5.0",
    "smol-toml": "1.4.2",
    "string-width": "7.2.0",
    "which": "6.0.1"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-rc.118",
    "@types/http-proxy": "1.17.17",
    "@types/which": "3.0.4",
    "vitest": "5.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
