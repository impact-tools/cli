{
  "name": "@impact-relay/cli",
  "version": "0.2.0",
  "description": "Launch coding clients through Impact LLM.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/impact-tools/cli.git"
  },
  "bin": {
    "impact": "./dist/impact.js"
  },
  "files": [
    "dist/impact.js",
    "README.md"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "dev": "IMPACT_LAUNCH_CWD=\"${IMPACT_LAUNCH_CWD:-$PWD}\" IMPACT_BASE_URL=\"${IMPACT_BASE_URL:-http://impactllm.localhost:4420}\" bun --no-env-file src/main.ts",
    "build": "bun --no-env-file build.ts",
    "build:bin": "bun --no-env-file build.ts --compile",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.2",
    "@effect/vitest": "4.0.2",
    "@types/bun": "1.4.2",
    "@types/http-proxy": "1.17.17",
    "@types/which": "3.0.4",
    "better-auth": "1.7.6",
    "effect": "4.0.2",
    "env-paths": "4.0.0",
    "es-toolkit": "1.52.0",
    "http-proxy": "1.18.1",
    "open": "11.0.4",
    "selfsigned": "5.5.0",
    "smol-toml": "1.4.2",
    "string-width": "7.2.0",
    "typescript": "7.0.2",
    "vitest": "5.0.2",
    "which": "6.0.1"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.4.2",
  "patchedDependencies": {
    "http-proxy@1.18.1": "patches/http-proxy@1.18.1.patch"
  }
}
